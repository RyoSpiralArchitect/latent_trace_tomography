{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiralreality.dev/schemas/ltt/causal-label-evidence-0.1.0.json",
  "title": "LTT raw D_causal_label evidence",
  "description": "One target's complete raw-output evidence for 128 unpatched canonical prompts and 192 primary intervention pairs under all four frozen conditions. Aggregate-only evidence is not authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "execution_lock_sha256",
    "target_id",
    "unpatched_trials",
    "intervention_trials"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "complete"},
    "execution_lock_sha256": {"$ref": "#/$defs/sha256"},
    "target_id": {"type": "string", "minLength": 1},
    "unpatched_trials": {
      "type": "array",
      "minItems": 128,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/unpatched_trial"}
    },
    "intervention_trials": {
      "type": "array",
      "minItems": 192,
      "maxItems": 192,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/intervention_trial"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unpatched_trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_id",
        "case_id",
        "prompt_sha256",
        "prompt_record_sha256",
        "oracle_final",
        "output_text",
        "output_text_sha256",
        "parsed_final",
        "oracle_correct",
        "activation_capture_record_sha256"
      ],
      "properties": {
        "prompt_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_record_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_final": {"enum": ["FINAL: A", "FINAL: B"]},
        "output_text": {"type": "string"},
        "output_text_sha256": {"$ref": "#/$defs/sha256"},
        "parsed_final": {
          "oneOf": [{"enum": ["A", "B"]}, {"type": "null"}]
        },
        "oracle_correct": {"type": "boolean"},
        "activation_capture_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "intervention_trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "causal_variable",
        "pair_id",
        "opaque_content_seed_id",
        "pair_record_sha256",
        "base_prompt_id",
        "base_prompt_sha256",
        "source_prompt_id",
        "source_prompt_sha256",
        "expected_patched_final",
        "base_oracle_final",
        "selected_site_id",
        "base_activation_capture_record_sha256",
        "source_activation_capture_record_sha256",
        "trial_order"
      ],
      "properties": {
        "causal_variable": {
          "enum": ["semantic_solution", "surface_cue", "answer_codebook"]
        },
        "pair_id": {"type": "string", "minLength": 1},
        "opaque_content_seed_id": {"$ref": "#/$defs/sha256"},
        "pair_record_sha256": {"$ref": "#/$defs/sha256"},
        "base_prompt_id": {"type": "string", "minLength": 1},
        "base_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "source_prompt_id": {"type": "string", "minLength": 1},
        "source_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "expected_patched_final": {"enum": ["FINAL: A", "FINAL: B"]},
        "base_oracle_final": {"enum": ["FINAL: A", "FINAL: B"]},
        "selected_site_id": {"type": "string", "minLength": 1},
        "base_activation_capture_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_activation_capture_record_sha256": {"$ref": "#/$defs/sha256"},
        "trial_order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/condition_trial"}
        }
      }
    },
    "condition_trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "order_index",
        "output_text",
        "output_text_sha256",
        "parsed_final",
        "success",
        "intervention_execution_record",
        "intervention_execution_record_sha256"
      ],
      "properties": {
        "condition_id": {
          "enum": [
            "targeted_interchange",
            "norm_matched_rotation",
            "self_sham",
            "control_site_delta"
          ]
        },
        "order_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "output_text": {"type": "string"},
        "output_text_sha256": {"$ref": "#/$defs/sha256"},
        "parsed_final": {
          "oneOf": [{"enum": ["A", "B"]}, {"type": "null"}]
        },
        "success": {"type": "boolean"},
        "intervention_execution_record": {
          "$ref": "#/$defs/intervention_execution_record"
        },
        "intervention_execution_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "intervention_execution_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_version",
        "partition_id",
        "operation_id",
        "order_index",
        "model_unit_id",
        "causal_variable",
        "pair_id",
        "canonical_site_id",
        "zero_based_layer_index",
        "module_path",
        "hook_boundary",
        "hidden_size",
        "factor_carrier_selector",
        "base_prompt_id",
        "base_prompt_sha256",
        "effective_source_prompt_id",
        "effective_source_prompt_sha256",
        "base_activation_capture_record_sha256",
        "effective_source_activation_capture_record_sha256",
        "base_carrier_binding_record_sha256",
        "effective_source_carrier_binding_record_sha256",
        "patched_position_indices",
        "matched_null_seed_u64",
        "matched_null_permutation_sha256",
        "matched_null_signs_sha256",
        "base_activation_tensor_sha256",
        "source_activation_tensor_sha256",
        "source_minus_base_delta_tensor_sha256",
        "patched_activation_tensor_sha256",
        "output_text_sha256",
        "runtime_ledger_entry",
        "runtime_ledger_entry_sha256"
      ],
      "properties": {
        "record_version": {"const": "intervention_execution_record_v1"},
        "partition_id": {"const": "D_causal_label"},
        "operation_id": {
          "enum": [
            "targeted_interchange",
            "norm_matched_rotation",
            "self_sham",
            "control_site_delta"
          ]
        },
        "order_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "model_unit_id": {"type": "string", "minLength": 1},
        "causal_variable": {
          "enum": ["semantic_solution", "surface_cue", "answer_codebook"]
        },
        "pair_id": {"type": "string", "minLength": 1},
        "canonical_site_id": {"type": "string", "minLength": 1},
        "zero_based_layer_index": {"type": "integer", "minimum": 0},
        "module_path": {"type": "string", "minLength": 1},
        "hook_boundary": {"const": "post_block_residual_before_next_block_v1"},
        "hidden_size": {"type": "integer", "minimum": 1},
        "factor_carrier_selector": {"type": "string", "minLength": 1},
        "base_prompt_id": {"type": "string", "minLength": 1},
        "base_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "effective_source_prompt_id": {"type": "string", "minLength": 1},
        "effective_source_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "base_activation_capture_record_sha256": {"$ref": "#/$defs/sha256"},
        "effective_source_activation_capture_record_sha256": {"$ref": "#/$defs/sha256"},
        "base_carrier_binding_record_sha256": {"$ref": "#/$defs/sha256"},
        "effective_source_carrier_binding_record_sha256": {"$ref": "#/$defs/sha256"},
        "patched_position_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "matched_null_seed_u64": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            {"type": "null"}
          ]
        },
        "matched_null_permutation_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "matched_null_signs_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "base_activation_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "source_activation_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "source_minus_base_delta_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "patched_activation_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "output_text_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_ledger_entry": {"$ref": "#/$defs/runtime_ledger_entry"},
        "runtime_ledger_entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_ledger_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_version",
        "discovery_authorization_id",
        "partition_id",
        "model_unit_id",
        "pair_id",
        "canonical_site_id",
        "operation_id",
        "order_index",
        "hook_adapter_id",
        "module_path",
        "zero_based_layer_index",
        "patched_position_indices",
        "base_tensor_role",
        "source_tensor_role",
        "base_activation_tensor_sha256",
        "source_activation_tensor_sha256",
        "source_minus_base_delta_tensor_sha256",
        "patched_activation_tensor_sha256",
        "patch_operator_id",
        "runtime_dtype",
        "source_tree_sha256",
        "environment_lock_sha256",
        "hook_call_count",
        "competing_hook_count",
        "relation_check_id",
        "relation_check_passed",
        "output_text_sha256"
      ],
      "properties": {
        "ledger_version": {"const": "trusted_authority_runtime_ledger_v1"},
        "discovery_authorization_id": {"type": "string", "minLength": 1},
        "partition_id": {"const": "D_causal_label"},
        "model_unit_id": {"type": "string", "minLength": 1},
        "pair_id": {"type": "string", "minLength": 1},
        "canonical_site_id": {"type": "string", "minLength": 1},
        "operation_id": {
          "enum": [
            "targeted_interchange",
            "norm_matched_rotation",
            "self_sham",
            "control_site_delta"
          ]
        },
        "order_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "hook_adapter_id": {"type": "string", "minLength": 1},
        "module_path": {"type": "string", "minLength": 1},
        "zero_based_layer_index": {"type": "integer", "minimum": 0},
        "patched_position_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "base_tensor_role": {
          "enum": ["base_carrier", "base_control"]
        },
        "source_tensor_role": {
          "enum": [
            "source_carrier",
            "base_carrier",
            "ordered_source_carrier_mapped_to_control"
          ]
        },
        "base_activation_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "source_activation_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "source_minus_base_delta_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "patched_activation_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "patch_operator_id": {
          "enum": [
            "direct_carrier_replacement_v1",
            "signed_permutation_carrier_delta_add_v1",
            "base_to_base_carrier_sham_v1",
            "ordered_carrier_to_control_replacement_v1"
          ]
        },
        "runtime_dtype": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "environment_lock_sha256": {"$ref": "#/$defs/sha256"},
        "hook_call_count": {"const": 1},
        "competing_hook_count": {"const": 0},
        "relation_check_id": {
          "enum": [
            "direct_replace_digest_equality_v1",
            "matched_null_parameter_and_replay_check_v1",
            "self_sham_identity_digest_equality_v1"
          ]
        },
        "relation_check_passed": {"const": true},
        "output_text_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
