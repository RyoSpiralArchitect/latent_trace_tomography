{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiralreality.dev/ltt/source_evidence_catalog-0.1.0.json",
  "title": "OSS-1 source evidence identity catalog v2",
  "description": "Fail-closed local binding from unchanged v1 source-record envelopes to typed JSON identity payloads. Validation establishes byte/content identity and catalog closure only; evidence-body truth, completeness, independence, claim derivation, and authorization sufficiency remain unvalidated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_type",
    "status",
    "catalog_id",
    "created_at",
    "payload_directory",
    "entries",
    "catalog_body_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "catalog_type": {
      "const": "source_evidence_catalog_v2"
    },
    "status": {
      "const": "identity_payloads_closed_not_evidence_sufficient"
    },
    "catalog_id": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload_directory": {
      "const": "payloads"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    },
    "catalog_body_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "sourceKind": {
      "enum": [
        "model_manifest",
        "tokenizer_manifest",
        "checkpoint_manifest",
        "training_run_manifest",
        "initialization_manifest",
        "rng_manifest",
        "training_recipe_manifest",
        "training_data_manifest",
        "task_manifest",
        "ancestry_manifest",
        "overlap_scan_manifest",
        "evaluation_exposure_scan_manifest",
        "environment_manifest"
      ]
    },
    "payloadSchemaKind": {
      "enum": [
        "model_evidence_v1",
        "tokenizer_evidence_v1",
        "checkpoint_evidence_v1",
        "training_run_evidence_v1",
        "initialization_evidence_v1",
        "rng_evidence_v1",
        "training_recipe_evidence_v1",
        "training_data_evidence_v1",
        "task_evidence_v1",
        "ancestry_evidence_v1",
        "overlap_evidence_v1",
        "evaluation_exposure_evidence_v1",
        "environment_evidence_v1"
      ]
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_kind",
        "content_sha256",
        "locator_sha256",
        "source_record_sha256",
        "relative_path",
        "raw_file_sha256",
        "payload_schema_kind"
      ],
      "properties": {
        "source_record_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^payloads/(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^/].*\\.json$"
        },
        "raw_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_schema_kind": {
          "$ref": "#/$defs/payloadSchemaKind"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "model_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "model_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "tokenizer_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "tokenizer_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "checkpoint_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "checkpoint_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "training_run_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "training_run_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "initialization_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "initialization_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "rng_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "rng_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "training_recipe_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "training_recipe_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "training_data_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "training_data_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "task_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "task_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "ancestry_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "ancestry_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "overlap_scan_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "overlap_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "evaluation_exposure_scan_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "evaluation_exposure_evidence_v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "environment_manifest"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "payload_schema_kind": {
                "const": "environment_evidence_v1"
              }
            }
          }
        }
      ]
    },
    "payloadEnvelope": {
      "type": "object",
      "required": [
        "schema_version",
        "payload_schema_kind",
        "source_kind",
        "source_record_id",
        "payload_id",
        "created_at",
        "identity",
        "evidence"
