      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "payload_schema_kind": {
          "$ref": "#/$defs/payloadSchemaKind"
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "source_record_id": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "payload_id": {
