{
  "$id": "https://spiralreality.dev/schemas/ltt/discovery_authorization-0.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Latent Trace Tomography discovery authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_freeze_id",
    "parent_design_manifest_sha256",
    "status",
    "discovery_authorization_id",
    "authorized_at",
    "parent_discovery_template_sha256",
    "parent_execution_template_sha256",
    "architecture_families",
    "model_registry",
    "learned_state_ancestry",
    "dependency_graph",
    "dependency_clusters",
    "nuisance_balance_contract",
    "activation_hook_registry",
    "tokenizer_compatibility",
    "live_seed_commitment",
    "live_material_manifest_sha256",
    "live_material_manifest",
    "discovery_content_seed_set_sha256",
    "discovery_case_set_sha256",
    "discovery_case_count",
    "discovery_projection_set_sha256",
    "discovery_intervention_pair_set_sha256",
    "discovery_primary_intervention_pair_set_sha256",
    "discovery_primary_pair_inventory_sha256",
    "discovery_prompt_inventory_sha256",
    "split_manifest_sha256",
    "candidate_site_set_sha256",
    "candidate_site_inventory",
    "candidate_site_algorithm",
    "discovery_panel_sha256",
    "discovery_query_plan",
    "discovery_decoding_config",
    "model_runtime_configuration",
    "carrier_binding_report_sha256",
    "carrier_binding_records",
    "carrier_binding_summary",
    "environment_lock"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "design_freeze_id": {"type": "string", "minLength": 1},
    "parent_design_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["unassigned", "authorized"]},
    "discovery_authorization_id": {"type": ["string", "null"]},
    "authorized_at": {"type": ["string", "null"], "format": "date-time"},
    "parent_discovery_template_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "parent_execution_template_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "architecture_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "model_registry": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/model_record"}
    },
    "learned_state_ancestry": {
      "oneOf": [{"$ref": "#/$defs/learned_state_ancestry"}, {"type": "null"}]
    },
    "dependency_graph": {
      "oneOf": [{"$ref": "#/$defs/dependency_graph"}, {"type": "null"}]
    },
    "dependency_clusters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dependency_cluster"}
    },
    "nuisance_balance_contract": {
      "oneOf": [{"$ref": "#/$defs/nuisance_balance_contract"}, {"type": "null"}]
    },
    "activation_hook_registry": {
      "oneOf": [{"$ref": "#/$defs/activation_hook_registry"}, {"type": "null"}]
    },
    "tokenizer_compatibility": {
      "oneOf": [{"$ref": "#/$defs/tokenizer_compatibility"}, {"type": "null"}]
    },
    "live_seed_commitment": {
      "oneOf": [{"$ref": "#/$defs/live_seed_commitment"}, {"type": "null"}]
    },
    "live_material_manifest_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "live_material_manifest": {"type": ["object", "null"]},
    "discovery_content_seed_set_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_case_set_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_case_count": {"type": ["integer", "null"], "minimum": 1},
    "discovery_projection_set_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_intervention_pair_set_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_primary_intervention_pair_set_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_primary_pair_inventory_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_prompt_inventory_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "split_manifest_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "candidate_site_set_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "candidate_site_inventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidate_site_panel"}
    },
    "candidate_site_algorithm": {
      "oneOf": [{"$ref": "#/$defs/candidate_site_algorithm"}, {"type": "null"}]
    },
    "discovery_panel_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "discovery_query_plan": {
      "oneOf": [{"$ref": "#/$defs/discovery_query_plan"}, {"type": "null"}]
    },
    "discovery_decoding_config": {
      "oneOf": [{"$ref": "#/$defs/decoding_config"}, {"type": "null"}]
    },
    "model_runtime_configuration": {
      "oneOf": [{"$ref": "#/$defs/model_runtime_configuration"}, {"type": "null"}]
    },
    "carrier_binding_report_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "carrier_binding_records": {
      "oneOf": [
        {"type": "array", "minItems": 1728, "maxItems": 1728, "items": {"$ref": "#/$defs/carrier_binding_record"}},
        {"type": "null"}
      ]
    },
    "carrier_binding_summary": {
      "oneOf": [{"$ref": "#/$defs/carrier_binding_summary"}, {"type": "null"}]
    },
    "environment_lock": {
      "oneOf": [{"$ref": "#/$defs/environment_lock"}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "unassigned"}}, "required": ["status"]},
      "then": {
        "properties": {
          "discovery_authorization_id": {"type": "null"},
          "authorized_at": {"type": "null"},
          "parent_discovery_template_sha256": {"type": "null"},
          "parent_execution_template_sha256": {"type": "null"},
          "architecture_families": {"maxItems": 0},
          "model_registry": {"maxItems": 0},
          "learned_state_ancestry": {"type": "null"},
          "dependency_graph": {"type": "null"},
          "dependency_clusters": {"maxItems": 0},
          "nuisance_balance_contract": {"type": "null"},
          "activation_hook_registry": {"type": "null"},
          "tokenizer_compatibility": {"type": "null"},
          "live_seed_commitment": {"type": "null"},
          "live_material_manifest_sha256": {"type": "null"},
          "live_material_manifest": {"type": "null"},
          "discovery_content_seed_set_sha256": {"type": "null"},
          "discovery_case_set_sha256": {"type": "null"},
          "discovery_case_count": {"type": "null"},
          "discovery_projection_set_sha256": {"type": "null"},
          "discovery_intervention_pair_set_sha256": {"type": "null"},
          "discovery_primary_intervention_pair_set_sha256": {"type": "null"},
          "discovery_primary_pair_inventory_sha256": {"type": "null"},
          "discovery_prompt_inventory_sha256": {"type": "null"},
          "split_manifest_sha256": {"type": "null"},
          "candidate_site_set_sha256": {"type": "null"},
          "candidate_site_inventory": {"maxItems": 0},
          "candidate_site_algorithm": {"type": "null"},
          "discovery_panel_sha256": {"type": "null"},
          "discovery_query_plan": {"type": "null"},
          "discovery_decoding_config": {"type": "null"},
          "model_runtime_configuration": {"type": "null"},
          "carrier_binding_report_sha256": {"type": "null"},
          "carrier_binding_records": {"type": "null"},
          "carrier_binding_summary": {"type": "null"},
          "environment_lock": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "authorized"}}, "required": ["status"]},
      "then": {
        "properties": {
          "discovery_authorization_id": {"type": "string", "minLength": 1},
          "authorized_at": {"type": "string", "format": "date-time"},
          "parent_discovery_template_sha256": {"$ref": "#/$defs/sha256"},
          "parent_execution_template_sha256": {"$ref": "#/$defs/sha256"},
          "architecture_families": {"minItems": 1},
          "model_registry": {"minItems": 9, "maxItems": 9},
          "learned_state_ancestry": {"$ref": "#/$defs/learned_state_ancestry"},
          "dependency_graph": {"$ref": "#/$defs/dependency_graph"},
          "dependency_clusters": {"minItems": 3, "maxItems": 3},
          "nuisance_balance_contract": {"$ref": "#/$defs/nuisance_balance_contract"},
          "activation_hook_registry": {"$ref": "#/$defs/activation_hook_registry"},
          "tokenizer_compatibility": {"$ref": "#/$defs/tokenizer_compatibility"},
          "live_seed_commitment": {"$ref": "#/$defs/live_seed_commitment"},
          "live_material_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "live_material_manifest": {"type": "object"},
          "discovery_content_seed_set_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_case_set_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_case_count": {"type": "integer", "minimum": 1},
          "discovery_projection_set_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_intervention_pair_set_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_primary_intervention_pair_set_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_primary_pair_inventory_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_prompt_inventory_sha256": {"$ref": "#/$defs/sha256"},
          "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "candidate_site_set_sha256": {"$ref": "#/$defs/sha256"},
          "candidate_site_inventory": {"minItems": 27, "maxItems": 27},
          "candidate_site_algorithm": {"$ref": "#/$defs/candidate_site_algorithm"},
          "discovery_panel_sha256": {"$ref": "#/$defs/sha256"},
          "discovery_query_plan": {"$ref": "#/$defs/discovery_query_plan"},
          "discovery_decoding_config": {"$ref": "#/$defs/decoding_config"},
          "model_runtime_configuration": {"$ref": "#/$defs/model_runtime_configuration"},
          "carrier_binding_report_sha256": {"$ref": "#/$defs/sha256"},
          "carrier_binding_records": {"type": "array", "minItems": 1728, "maxItems": 1728},
          "carrier_binding_summary": {"$ref": "#/$defs/carrier_binding_summary"},
          "environment_lock": {"$ref": "#/$defs/environment_lock"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "learned_state_ancestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "external_artifacts", "records", "inventory_sha256"],
      "properties": {
        "policy_id": {"const": "complete_learned_state_parent_inventory_fail_closed_v1"},
        "external_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/external_ancestry_artifact"}},
        "records": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/ancestry_record"}},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "external_ancestry_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "artifact_role", "source_record_sha256"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_role": {"enum": ["shared_base", "external_teacher", "merge_parent", "adapter_base"]},
        "source_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ancestry_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_unit_id", "model_artifact_sha256", "ancestry_complete", "ambiguous_parentage", "parents"],
      "properties": {
        "model_unit_id": {"type": "string", "minLength": 1},
        "model_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "ancestry_complete": {"const": true},
        "ambiguous_parentage": {"const": false},
        "parents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ancestry_parent"}}
      }
    },
    "ancestry_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_artifact_sha256", "parent_model_unit_id", "relationship", "source_record_sha256"],
      "properties": {
        "parent_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "parent_model_unit_id": {"type": ["string", "null"]},
        "relationship": {"enum": ["shared_learned_weights", "base_descendant", "continued_pretraining", "fine_tune", "adapter", "quantization", "merge_parent", "distillation_teacher"]},
        "source_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "carrier_binding_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_unit_id", "tokenizer_artifact_sha256", "prompt_id", "case_id", "prompt_sha256", "prompt_record_sha256", "causal_variable", "factor_carrier_selector", "carrier_token_ids", "carrier_position_indices", "control_site_selector", "control_token_ids", "control_position_indices", "tokenized_input_length", "missing", "ambiguous", "truncated", "compatible"],
      "properties": {
        "model_unit_id": {"type": "string", "minLength": 1},
        "tokenizer_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_record_sha256": {"$ref": "#/$defs/sha256"},
        "causal_variable": {"enum": ["semantic_solution", "surface_cue", "answer_codebook"]},
        "factor_carrier_selector": {"type": "string", "minLength": 1},
        "carrier_token_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "carrier_position_indices": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "control_site_selector": {"type": "string", "minLength": 1},
        "control_token_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "control_position_indices": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "tokenized_input_length": {"type": "integer", "minimum": 1},
        "missing": {"const": false},
        "ambiguous": {"const": false},
        "truncated": {"const": false},
        "compatible": {"const": true}
      }
    },
    "model_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_unit_id",
        "independent_training_run_id",
        "checkpoint_id",
        "lineage_id",
        "dependency_cluster_id",
        "architecture_family_id",
        "anchor_condition_id",
        "model_id",
        "model_revision",
        "model_artifact_sha256",
        "shared_base_artifact_sha256",
        "configuration_sha256",
        "tokenizer_revision",
        "tokenizer_artifact_sha256",
        "anchor_provenance"
      ],
      "properties": {
        "model_unit_id": {"type": "string", "minLength": 1},
        "independent_training_run_id": {"type": "string", "minLength": 1},
        "checkpoint_id": {"type": "string", "minLength": 1},
        "lineage_id": {"type": "string", "minLength": 1},
        "dependency_cluster_id": {"type": "string", "minLength": 1},
        "architecture_family_id": {"type": "string", "minLength": 1},
        "anchor_condition_id": {
          "enum": ["semantic_anchor", "surface_cue_anchor", "mixed_anchor"]
        },
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "model_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "shared_base_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_revision": {"type": "string", "minLength": 1},
        "tokenizer_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_provenance": {"$ref": "#/$defs/anchor_provenance"}
      }
    },
    "anchor_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_timing",
        "anchor_assignment_manifest_sha256",
        "training_recipe_sha256",
        "training_data_sha256"
      ],
      "properties": {
        "assignment_timing": {"const": "pre_outcome_training_condition"},
        "anchor_assignment_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "training_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "training_data_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "nodes", "edges"],
      "properties": {
        "algorithm": {"const": "undirected_learned_state_connected_components_v1"},
        "nodes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependency_edge"}
        }
      }
    },
    "dependency_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_model_unit_id", "target_model_unit_id", "kind"],
      "properties": {
        "source_model_unit_id": {"type": "string", "minLength": 1},
        "target_model_unit_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "shared_learned_weights",
            "base_descendant",
            "continued_pretraining",
            "fine_tune",
            "adapter",
            "quantization",
            "merge_parent",
            "distillation_teacher"
          ]
        }
      }
    },
    "dependency_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_cluster_id", "model_unit_ids"],
      "properties": {
        "dependency_cluster_id": {"type": "string", "minLength": 1},
        "model_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tokenizer_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "add_special_tokens", "records"],
      "properties": {
        "algorithm": {"const": "final_marker_single_continuation_v1"},
        "add_special_tokens": {"const": false},
        "records": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tokenizer_record"}
        }
      }
    },
    "tokenizer_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_unit_id",
        "tokenizer_revision",
        "tokenizer_artifact_sha256",
        "final_prefix_token_ids",
        "final_a_token_ids",
        "final_b_token_ids",
        "final_a_continuation_token_id",
        "final_b_continuation_token_id",
        "compatible"
      ],
      "properties": {
        "model_unit_id": {"type": "string", "minLength": 1},
        "tokenizer_revision": {"type": "string", "minLength": 1},
        "tokenizer_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "final_prefix_token_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "final_a_token_ids": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
        "final_b_token_ids": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
        "final_a_continuation_token_id": {"type": "integer", "minimum": 0},
        "final_b_continuation_token_id": {"type": "integer", "minimum": 0},
        "compatible": {"const": true}
      }
    },
    "live_seed_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_secret_commitment_sha256",
        "authority_secret_entropy_bits",
        "secret_generation",
        "derivation_algorithm",
        "derivation_domain",
        "requested_content_seed_count",
        "derived_seed_set_sha256"
      ],
      "properties": {
        "authority_secret_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "authority_secret_entropy_bits": {"type": "integer", "minimum": 256},
        "secret_generation": {"const": "operating_system_csprng"},
        "derivation_algorithm": {
          "const": "hmac_sha256_first_64bit_domain_separated_v1"
        },
        "derivation_domain": {"const": "ltt:live-content-seed:v1"},
        "requested_content_seed_count": {"const": 64},
        "derived_seed_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nuisance_balance_contract": {
      "const": {
        "cluster_constant_fields": [
          "architecture_family_id",
          "tokenizer_revision",
          "tokenizer_artifact_sha256",
          "shared_base_artifact_sha256",
          "anchor_provenance.training_data_sha256",
          "anchor_provenance.anchor_assignment_manifest_sha256",
          "discovery_decoding_config.records_except_model_unit_id",
          "model_runtime_configuration.records_except_model_unit_id"
        ],
        "anchor_varying_fields": ["configuration_sha256", "model_artifact_sha256"],
        "cross_cluster_identity_forbidden": [
          "checkpoint_id",
          "lineage_id",
          "model_artifact_sha256"
        ]
      }
    },
    "candidate_site_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_unit_id", "causal_variable", "candidates"],
      "properties": {
        "model_unit_id": {"type": "string", "minLength": 1},
        "causal_variable": {
          "enum": ["semantic_solution", "surface_cue", "answer_codebook"]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidate_site"}
        }
      }
    },
    "candidate_site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_site_id",
        "architecture_family_id",
        "module_path",
        "zero_based_layer_index",
        "hook_boundary",
        "hidden_size",
        "factor_carrier_selector"
      ],
      "properties": {
        "canonical_site_id": {"type": "string", "minLength": 1},
        "architecture_family_id": {"type": "string", "minLength": 1},
        "module_path": {"type": "string", "minLength": 1},
        "zero_based_layer_index": {"type": "integer", "minimum": 0},
        "hook_boundary": {
          "const": "post_block_residual_before_next_block_v1"
        },
        "hidden_size": {"type": "integer", "minimum": 1},
        "factor_carrier_selector": {"type": "string", "minLength": 1}
      }
    },
    "candidate_site_algorithm": {
      "type": "object",
      "x-frozen-reference": {
        "algorithm_id": "factor_specific_residual_stream_post_argmax_v1",
        "causal_variables": [
          "semantic_solution",
          "surface_cue",
          "answer_codebook"
        ],
        "candidate_activation": "residual_stream_post",
        "carrier_token_selectors": {
          "semantic_solution": "final token of the decisive evidence span",
          "surface_cue": "final token of the surface cue span",
          "answer_codebook": "last token of each ACCEPT and REJECT codebook mapping line, treated as one two-position site"
        },
        "selection_score": "mean(targeted_success - norm_matched_rotation_success) over every preplanned symmetric-primary-stratum D_site_discovery pair",
        "selected_site_count_per_model_variable": 1,
        "tie_break_order": [
