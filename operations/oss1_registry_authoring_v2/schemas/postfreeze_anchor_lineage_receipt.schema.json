{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-trace-tomography.local/schemas/postfreeze_anchor_lineage_receipt.schema.json",
  "title": "Post-freeze outcome-naive anchor lineage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "status",
    "policy_id",
    "receipt_id",
    "created_at",
    "registry_id",
    "registry_body_sha256",
    "base_model_intake_body_sha256",
    "base_model_intake_file_sha256",
    "anchor_construction_plan_body_sha256",
    "anchor_construction_plan_file_sha256",
    "records",
    "training_model_calls_disclosed",
    "evaluation_model_calls_before_registry",
    "outcomes_exposed_before_registry",
    "authorization_effect",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "receipt_type": {"const": "postfreeze_anchor_lineage_receipt_v1"},
    "status": {"const": "outcome_naive_training_lineage_closed"},
    "policy_id": {"const": "pre_freeze_base_clean_postfreeze_descendant_v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_body_sha256": {"$ref": "#/$defs/sha256"},
    "base_model_intake_body_sha256": {"$ref": "#/$defs/sha256"},
    "base_model_intake_file_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_construction_plan_body_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_construction_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "records": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/record"}
    },
    "training_model_calls_disclosed": {"const": true},
    "evaluation_model_calls_before_registry": {"const": 0},
    "outcomes_exposed_before_registry": {"const": false},
    "authorization_effect": {"const": "none"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_unit_id",
        "training_run_id",
        "anchor_condition_id",
        "attempt_index",
        "completion_status",
        "selection_policy",
        "base_model_record_sha256",
        "base_checkpoint_artifact_sha256",
        "base_tokenizer_artifact_sha256",
        "base_checkpoint_created_at",
        "descendant_checkpoint_manifest_sha256",
        "descendant_model_artifact_sha256",
        "descendant_configuration_sha256",
        "descendant_tokenizer_artifact_sha256",
        "anchor_assignment_manifest_sha256",
        "anchor_assignment_committed_at",
        "training_recipe_sha256",
        "training_data_sha256",
        "derived_target_inventory_sha256",
        "training_started_at",
        "training_completed_at",
        "descendant_checkpoint_created_at",
        "fixed_optimizer_step_count",
        "training_forward_call_count",
        "training_backward_call_count",
        "outcome_access_before_checkpoint",
        "exact_live_prompt_exposed_to_training_runtime",
        "frozen_evaluation_generator_imported_by_training_runtime",
        "frozen_evaluation_template_exposed_to_training_runtime",
        "record_sha256"
      ],
      "properties": {
        "model_unit_id": {"type": "string", "minLength": 1},
        "training_run_id": {"type": "string", "minLength": 1},
        "anchor_condition_id": {"enum": ["semantic_anchor", "surface_cue_anchor", "mixed_anchor"]},
        "attempt_index": {"const": 1},
        "completion_status": {"const": "complete_fixed_steps"},
        "selection_policy": {"const": "retain_first_complete_attempt_no_outcome_selection"},
        "base_model_record_sha256": {"$ref": "#/$defs/sha256"},
        "base_checkpoint_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "base_tokenizer_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "base_checkpoint_created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "descendant_checkpoint_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "descendant_model_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "descendant_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "descendant_tokenizer_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_assignment_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_assignment_committed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "training_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "training_data_sha256": {"$ref": "#/$defs/sha256"},
        "derived_target_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "training_started_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "training_completed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "descendant_checkpoint_created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "fixed_optimizer_step_count": {"type": "integer", "minimum": 1},
        "training_forward_call_count": {"type": "integer", "minimum": 1},
        "training_backward_call_count": {"type": "integer", "minimum": 1},
        "outcome_access_before_checkpoint": {"const": false},
        "exact_live_prompt_exposed_to_training_runtime": {"const": false},
        "frozen_evaluation_generator_imported_by_training_runtime": {"const": false},
        "frozen_evaluation_template_exposed_to_training_runtime": {"const": false},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
